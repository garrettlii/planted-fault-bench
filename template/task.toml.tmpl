version = "1.1"
instruction_version = "1.0"
test_version = "1.0"
# Copied out of the agent container after it finishes and re-materialized at the same
# paths inside the separate verifier container. Nothing else crosses over.
artifacts = ["/app/output", "/app/analysis"]

[metadata]
task_id = "$TASK_ID"
title = "Child vs adult connectivity segregation (planted-fault-bench)"
category = "Scientific judgement"
difficulty = "hard"
dataset_source = "OpenNeuro ds000228 (nilearn-pinned derivatives), pre-extracted ROI series"
dataset_id = "ds000228"
benchmark = "planted-fault-bench"
batch = "$BATCH"

[verifier]
timeout_sec = 600.0
# Grade in a fresh container built from the same image, with no network.
environment_mode = "separate"
network_mode = "no-network"

[agent]
timeout_sec = 3600.0

[environment]
build_timeout_sec = 1800.0
cpus = 2
memory_mb = 4096
storage_mb = 8192
gpus = 0
# Agent CLIs need to install and reach their model API.
network_mode = "public"

[verifier.env]

[solution.env]
